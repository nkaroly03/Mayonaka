    fn int_list_fill(n: int, fill_val: int) []int {
        let l: []int = [];
        for (0..n) |_|
            push_back(l, fill_val);
        return l;
    }
    fn float_list_add(l: []float, val: float) void {
        for (0..len(l)) |i|
            l[i] = l[i] + val;
    }
    fn fib(n: int) int {
        fn _fib(n: int) int {
            if (n < 2) return n;
            return _fib(n - 1) + _fib(n - 2);
        }
        return _fib(n);
    }
/*/

fn main() int {
    {
        fn fib(n: int) int {
            fn _fib(n: int) int {
                fn fib(n: int) int {
                    fn _fib(n: int) int {
                        if (n < 2)
                            return n;
                        return _fib(n - 1) + _fib(n - 2);
                    }
                    return _fib(n);
                }
                return fib(n);
            }
            return _fib(n);
        }

        let i: int = 0;
        while (true) : (i = i + 1){
            let result: int = fib(i);
            if (result < 2000000){
                print(result);
                print('\n');
                continue;
            }
            break;
        }
    }

    fn print_fib() void {
        let i0: int = 0;
        let i1: int = 1;
        while (i0 >= 0){
            print(i0);
            let temp: int = i0 + i1;
            i0 = i1;
            i1 = temp;
            print('\n'); 
        }
    }

    print_fib();

    let i0: int = 0;
    let i1: int = 1;
    while (i0 >= 0){
        print(i0);
        let temp: int = i0 + i1;
        i0 = i1;
        i1 = temp;
        print('\n'); 
    }
    return 0;
}

return main();
