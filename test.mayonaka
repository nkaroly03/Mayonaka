fn main() int {
    let i0: int = 0;
    let i1: int = 1;
    while (i0 >= 0) : ({ print(i0); print('\n'); }){
        let temp: int = i0 + i1;
        i0 = i1;
        i1 = temp;
    }
    return 0;
}

return main();
