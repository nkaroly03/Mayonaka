    fn int_list_fill(n: int, fill_val: int) []int {
        let l: []int = [];
        for (0..n) |_|
            push_back(l, fill_val);
        return l;
    }
    fn float_list_add(l: []float, val: float) void {
        for (0..len(l)) |i|
            l[i] = l[i] + val;
    }
    fn fib(n: int) int {
        fn _fib(n: int) int {
            if (n < 2) return n;
            return _fib(n - 1) + _fib(n - 2);
        }
        return _fib(n);
    }

