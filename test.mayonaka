outer: for (0..10) |i|{
    inner: for (0..10) |j|{
        print("i: ");
        print(i);
        print(", j: ");
        print(j);
        print('\n');
        break outer;
    }
    print("----------------\n");
}


let INT_MSB: int = 0x8000000000000000;

fn int_to_bin_str(x: int) str {
    let result: str = "";
    let i: int = 0;
    while (i < 64) : (i = i + 1){
        let c: char = '0';
        c = c + (((x << i) & INT_MSB) != 0);
        result = result + c;
    }
    return result;
}

for (0..INT_MSB - 1) |i|
    print(int_to_bin_str(i) + '\n');

