let PI: float = 3.14159265;

fn floor(x: float) float {
    let rem: float = x % 1.0;
    return x - rem - (rem != 0.0 and x < 0.0);
}
fn ceil(x: float) float {
    let rem: float = x % 1.0;
    return x - rem + (rem != 0.0 and x > 0.0);
}
fn round(x: float) float {
    let rem: float = x % 1.0;
    if (rem != 0.0){
        if (x > 0)
            x = x - rem + (rem >= 0.5);
        else
            x = x - rem + (rem <= -0.5);
    }
    return x;
}

fn sin(x: float) float {
    let PI2: float = PI / 2.0;

    let n: int = floor(x / PI2);
    let q: int = n & 3;

    x = x - n * PI2;

    if (q & 1)
        x = PI2 - x;

    x = x - x ** 3.0 / 6.0 + x ** 5.0 / 120.0 - x ** 7.0 / 5040.0;

    if (q > 1)
        x = -x;

    return x;
}

let WIDTH:       int = 128;
let HEIGHT:      int = 32;
let FREQUENCY: float = 8.0;

let STEP: float = 0.1;

fn main() int {
    let buf: str = "";
    for (0..(WIDTH + 1) * HEIGHT) |_|
        buf = buf + ' ';

    for (0..HEIGHT) |y|{
        let x: float = 0.0;
        while (x < WIDTH) : (x = x + STEP){
            let sin: float = 0.985 ** x * sin(2.0 * PI * FREQUENCY * x / WIDTH);

            let int_cast: int = sin * HEIGHT / 2.0;
            if (HEIGHT / 2 - y == int_cast)
                buf[y * (WIDTH + 1) + (int_cast = x)] = '*';
        }
        buf[(y + 1) * (WIDTH + 1) - 1] = '\n';
    }

    print(buf);

    return 0;
}

return main();
