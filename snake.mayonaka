let WIDTH:  int = 30;
let HEIGHT: int = 30;

let WIDTH_HALF:  int = WIDTH  / 2;
let HEIGHT_HALF: int = HEIGHT / 2;

let SNAKE_FIELD_TYPE_IDX_NONE:       int = 0;
let SNAKE_FIELD_TYPE_IDX_OBSTACLE:   int = 1;
let SNAKE_FIELD_TYPE_IDX_APPLE:      int = 2;
let SNAKE_FIELD_TYPE_IDX_SNAKE_TAIL: int = 3;
let SNAKE_FIELD_TYPE_IDX_SNAKE_HEAD: int = 4;

let SNAKE_FIELD_TYPE_SYMBOLS: []str = [];
push_back(SNAKE_FIELD_TYPE_SYMBOLS, " ");
push_back(SNAKE_FIELD_TYPE_SYMBOLS, "\x1b[0mX");
push_back(SNAKE_FIELD_TYPE_SYMBOLS, "\x1b[31m$");
push_back(SNAKE_FIELD_TYPE_SYMBOLS, "\x1b[32m*");
push_back(SNAKE_FIELD_TYPE_SYMBOLS, "\x1b[32m@");

let MOVE_STATE_UP:    int = 0;
let MOVE_STATE_DOWN:  int = 1;
let MOVE_STATE_LEFT:  int = 2;
let MOVE_STATE_RIGHT: int = 3;

let stop: bool = false;
while (not stop){
    print("\x1b[?25l\x1b[2J\x1b[H");

    let snake_field: []int = [];
    for (0..WIDTH * HEIGHT) |_|
        push_back(snake_field, SNAKE_FIELD_TYPE_IDX_NONE);

    let obstacles_buf: [][]int = [];
    for (0..HEIGHT) |y|{
        for (0..WIDTH) |x|{
            let temp: []int = [];
            push_back(temp, x);
            push_back(temp, y);
            push_back(obstacles_buf, temp);
        }
    }
    {
        let i: int = len(obstacles_buf);
        while (i > 1){
            let j: int = (rand() & ~(1 << 63)) % i;
            i = i - 1;
            let temp: []int = obstacles_buf[i];
            obstacles_buf[i] = obstacles_buf[j];
            obstacles_buf[j] = temp;
        }
    }
    let obstacles_start_idx: int = len(obstacles_buf) - 3;

    let snake_parts_buf: [][]int = [];
    {
        let temp: []int = [];
        push_back(temp, WIDTH_HALF + 1);
        push_back(temp, HEIGHT_HALF);
        push_back(snake_parts_buf, temp);
    }
    {
        let temp: []int = [];
        push_back(temp, WIDTH_HALF);
        push_back(temp, HEIGHT_HALF);
        push_back(snake_parts_buf, temp);
    }
    {
        let temp: []int = [];
        push_back(temp, WIDTH_HALF - 1);
        push_back(temp, HEIGHT_HALF);
        push_back(snake_parts_buf, temp);
    }

    let move_state: int = MOVE_STATE_RIGHT;

    let apple: []int = obstacles_buf[(rand() & ~(1 << 63)) % obstacles_start_idx];

    while (true){
        let snake_head_pos_x: int = snake_parts_buf[0][0];
        let snake_head_pos_y: int = snake_parts_buf[0][1];

        {
            let collision: bool = false;

            let i: int = 1;
            while (not collision and i < len(snake_parts_buf)){
                collision = snake_head_pos_x == snake_parts_buf[i][0] and snake_head_pos_y == snake_parts_buf[i][1];
                i = i + 1;
            }
            if (collision)
                break;

            i = obstacles_start_idx;
            while (not collision and i < len(obstacles_buf)){
                collision = snake_head_pos_x == obstacles_buf[i][0] and snake_head_pos_y == obstacles_buf[i][1];
                i = i + 1;
            }
            if (collision)
                break;
            
            if (snake_head_pos_x == apple[0] and snake_head_pos_y == apple[1]){
                let new_snake_part: []int = [];
                push_back(new_snake_part, snake_parts_buf[len(snake_parts_buf) - 1][0]);
                push_back(new_snake_part, snake_parts_buf[len(snake_parts_buf) - 1][1]);
                push_back(snake_parts_buf, new_snake_part);

                if (len(snake_parts_buf) % 2 == 0)
                    obstacles_start_idx = obstacles_start_idx - 1;

                apple = obstacles_buf[(rand() & ~(1 << 63)) % obstacles_start_idx];
            }
        }
        
        {
            for (0..len(snake_field)) |i|
                snake_field[i] = SNAKE_FIELD_TYPE_IDX_NONE;

            for (obstacles_start_idx..len(obstacles_buf)) |i|
                snake_field[obstacles_buf[i][1] * WIDTH + obstacles_buf[i][0]] = SNAKE_FIELD_TYPE_IDX_OBSTACLE;

            snake_field[apple[1] * WIDTH + apple[0]] = SNAKE_FIELD_TYPE_IDX_APPLE;

            for (1..len(snake_parts_buf)) |i|
                snake_field[snake_parts_buf[i][1] * WIDTH + snake_parts_buf[i][0]] = SNAKE_FIELD_TYPE_IDX_SNAKE_TAIL;
            snake_field[snake_head_pos_y * WIDTH + snake_head_pos_x] = SNAKE_FIELD_TYPE_IDX_SNAKE_HEAD;
        }

        {
            let table: str = "";

            for (0..WIDTH + 2) |_|
                table = table + '#';
            table = table + '\n';
            for (0..HEIGHT) |y|{
                table = table + "\x1b[0m#";
                for (0..WIDTH) |x|
                    table = table + SNAKE_FIELD_TYPE_SYMBOLS[snake_field[y * WIDTH + x]];
                table = table + "\x1b[0m#\n";
            }
            for (0..WIDTH + 2) |_|
                table = table + '#';
            table = table + '\n';

            print(table);
            print("\x1b[H");
        }

        {
            let keypress: char = poll_keypress();
            if (keypress){
                if (keypress == '\x1b')
                    break;

                keypress = keypress + (keypress >= 'A' and keypress <= 'Z') * ('a' - 'A');
                if (keypress == 'w')
                    move_state = MOVE_STATE_UP;
                else if (keypress == 's')
                    move_state = MOVE_STATE_DOWN;
                else if (keypress == 'a')
                    move_state = MOVE_STATE_LEFT;
                else if (keypress == 'd')
                    move_state = MOVE_STATE_RIGHT;
            }
        }

        {
            let new_head_pos_x: int = snake_head_pos_x;
            let new_head_pos_y: int = snake_head_pos_y;

            if (move_state == MOVE_STATE_UP){
                if (new_head_pos_y == 0)
                    new_head_pos_y = HEIGHT - 1;
                else
                    new_head_pos_y = new_head_pos_y - 1;
            }
            else if (move_state == MOVE_STATE_DOWN)
                new_head_pos_y = (new_head_pos_y + 1) % HEIGHT;
            else if (move_state == MOVE_STATE_LEFT){
                if (new_head_pos_x == 0)
                    new_head_pos_x = WIDTH - 1;
                else
                    new_head_pos_x = new_head_pos_x - 1;
            }
            else
                new_head_pos_x = (new_head_pos_x + 1) % WIDTH;

            for (0..len(snake_parts_buf)) |i|{
                let x: int = snake_parts_buf[i][0];
                let y: int = snake_parts_buf[i][1];
                snake_parts_buf[i][0] = new_head_pos_x;
                snake_parts_buf[i][1] = new_head_pos_y;
                new_head_pos_x = x;
                new_head_pos_y = y;
            }
        }

        nsleep(50000000);
    }

    print("\x1b[0m\x1b[?25h\x1b[2JDo you wish to restart? (y/n): ");

    while (true){
        let keypress: char = poll_keypress();
        keypress = keypress + (keypress >= 'A' and keypress <= 'Z') * ('a' - 'A');
        if (keypress == 'y' or keypress == 'n'){
            stop = (keypress == 'n');
            break;
        }
    }
}
