let TETRIS_WIDTH:     int = 10;
let TETRIS_HEIGHT:    int = 20;
let TETRIS_MOVE_TICK: int = 20;

let TETROMINO_SHAPE_IDX_SQR:  int = 0;
let TETROMINO_SHAPE_IDX_Z0:   int = 1;
let TETROMINO_SHAPE_IDX_Z1:   int = 2;
let TETROMINO_SHAPE_IDX_L0:   int = 3;
let TETROMINO_SHAPE_IDX_L1:   int = 4;
let TETROMINO_SHAPE_IDX_T:    int = 5;
let TETROMINO_SHAPE_IDX_I:    int = 6;
let TETROMINO_SHAPE_IDX_NONE: int = 7;

let TETROMINO_ROTATION_IDX_0:   int = 0;
let TETROMINO_ROTATION_IDX_90:  int = 1;
let TETROMINO_ROTATION_IDX_180: int = 2;
let TETROMINO_ROTATION_IDX_270: int = 3;

let TETROMINO_SHAPE_SIDE_LENGTHS: []int = [];
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 2);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 3);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 3);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 3);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 3);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 3);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 4);
push_back(TETROMINO_SHAPE_SIDE_LENGTHS, 0);

let TETROMINO_SHAPE_TABLES: []str = [];
push_back(
    TETROMINO_SHAPE_TABLES,
    "XX"
    "XX"
);
push_back(
    TETROMINO_SHAPE_TABLES,
    ".XX"
    "XX."
    "..."
);
push_back(
    TETROMINO_SHAPE_TABLES,
    "XX."
    ".XX"
    "..."
);
push_back(
    TETROMINO_SHAPE_TABLES,
    "..X"
    "XXX"
    "..."
);
push_back(
    TETROMINO_SHAPE_TABLES,
    "X.."
    "XXX"
    "..."
);
push_back(
    TETROMINO_SHAPE_TABLES,
    ".X."
    "XXX"
    "..."
);
push_back(
    TETROMINO_SHAPE_TABLES,
    "...."
    "XXXX"
    "...."
    "...."
);
push_back(TETROMINO_SHAPE_TABLES, "");

let TETROMINO_SHAPE_SYMBOLS: []str = [];
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;255;255;0m#");
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;0;255;0m#");
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;255;0;0m#");
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;255;127;0m#");
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;255;255;255m#");
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;255;0;255m#");
push_back(TETROMINO_SHAPE_SYMBOLS, "\x1b[38;2;0;255;255m#");
push_back(TETROMINO_SHAPE_SYMBOLS, " ");

let TETROMINO_SHAPE_IDX_IDX:    int = 0;
let TETROMINO_ROTATION_IDX_IDX: int = 1;
let TETROMINO_X_POS_IDX:        int = 2;
let TETROMINO_Y_POS_IDX:        int = 3;

fn tetromino_init() []int {
    let result: []int = [];
    push_back(result, (rand() & ~0x8000000000000000) % TETROMINO_SHAPE_IDX_NONE);
    push_back(result, TETROMINO_ROTATION_IDX_0);
    push_back(result, TETRIS_WIDTH / 2 - 1);
    push_back(result, 0);
    return result;
}

fn tetromino_rotate_idx(shape_idx: int, rotation_idx: int, x_idx: int, y_idx: int) int {
    let result: int = 0;
    let side_length: int = TETROMINO_SHAPE_SIDE_LENGTHS[shape_idx];

    if (rotation_idx == TETROMINO_ROTATION_IDX_0)
        result = y_idx * side_length + x_idx;
    else if (rotation_idx == TETROMINO_ROTATION_IDX_90)
        result = ((side_length - 1) * side_length) + y_idx - side_length * x_idx;
    else if (rotation_idx == TETROMINO_ROTATION_IDX_180)
        result = (side_length * side_length - 1) - side_length * y_idx - x_idx;
    else
        result = (side_length - 1) - y_idx + side_length * x_idx;

    return result;
}

fn tetromino_rotate_left(tetromino: []int) void {
    let temp: int = tetromino[TETROMINO_ROTATION_IDX_IDX];
    if (temp != TETROMINO_ROTATION_IDX_0)
        temp = temp - 1;
    else
        temp = TETROMINO_ROTATION_IDX_270;
    tetromino[TETROMINO_ROTATION_IDX_IDX] = temp;
}
fn tetromino_rotate_right(tetromino: []int) void {
    tetromino[TETROMINO_ROTATION_IDX_IDX] = (tetromino[TETROMINO_ROTATION_IDX_IDX] + 1) % (TETROMINO_ROTATION_IDX_270 + 1);
}

fn tetris_init_next_tetromino_table(next_tetromino: []int) str {
    let next_tetromino_table: str = "";

    let shape_idx:    int = next_tetromino[TETROMINO_SHAPE_IDX_IDX];
    let rotation_idx: int = next_tetromino[TETROMINO_ROTATION_IDX_IDX];

    let side_length:  int = TETROMINO_SHAPE_SIDE_LENGTHS[shape_idx];
    let shape_table:  str = TETROMINO_SHAPE_TABLES[shape_idx];
    let shape_symbol: str = TETROMINO_SHAPE_SYMBOLS[shape_idx];

    for (0..side_length) |y|{
        for (0..side_length) |x|{
            if (shape_table[y * side_length + x] == 'X')
                next_tetromino_table = next_tetromino_table + shape_symbol;
            else
                next_tetromino_table = next_tetromino_table + ' ';
        }
        for (side_length..4) |_|
            next_tetromino_table = next_tetromino_table + ' ';
        next_tetromino_table = next_tetromino_table + '\n';
    }

    for (side_length..4) |_|
        next_tetromino_table = next_tetromino_table + '\n';

    return next_tetromino_table;
}

fn tetris_tetromino_fits(tetris_field: []int, tetromino: []int) bool {
    let shape_idx:    int = tetromino[TETROMINO_SHAPE_IDX_IDX];
    let rotation_idx: int = tetromino[TETROMINO_ROTATION_IDX_IDX];

    let side_length: int = TETROMINO_SHAPE_SIDE_LENGTHS[shape_idx];
    let shape_table: str = TETROMINO_SHAPE_TABLES[shape_idx];

    for (0..side_length) |y|{
        for (0..side_length) |x|{
            if (shape_table[tetromino_rotate_idx(shape_idx, rotation_idx, x, y)] == 'X'){
                let x_pos: int = x + tetromino[TETROMINO_X_POS_IDX];
                let y_pos: int = y + tetromino[TETROMINO_Y_POS_IDX];
                if (x_pos < 0 or x_pos >= TETRIS_WIDTH or y_pos < 0 or y_pos >= TETRIS_HEIGHT or tetris_field[y_pos * TETRIS_WIDTH + x_pos] != TETROMINO_SHAPE_IDX_NONE)
                    return false;
            }
        }
    }

    return true;
}

fn tetris_setup_field_as(tetris_field: []int, tetromino: []int, shape_idx_as: int) void {
    let shape_idx:    int = tetromino[TETROMINO_SHAPE_IDX_IDX];
    let rotation_idx: int = tetromino[TETROMINO_ROTATION_IDX_IDX];
    
    let side_length: int = TETROMINO_SHAPE_SIDE_LENGTHS[shape_idx];
    let shape_table: str = TETROMINO_SHAPE_TABLES[shape_idx];

    for (0..side_length) |y|{
        for (0..side_length) |x|{
            if (shape_table[tetromino_rotate_idx(shape_idx, rotation_idx, x, y)] == 'X'){
                let x_pos: int = x + tetromino[TETROMINO_X_POS_IDX];
                let y_pos: int = y + tetromino[TETROMINO_Y_POS_IDX];
                tetris_field[y_pos * TETRIS_WIDTH + x_pos] = shape_idx_as;
            }
        }
    }
}

fn tetris_row_is_full(tetris_field: []int, y_idx: int) bool {
    for (0..TETRIS_WIDTH) |x|
        if (tetris_field[y_idx * TETRIS_WIDTH + x] == TETROMINO_SHAPE_IDX_NONE)
            return false;
    return true;
}

fn main() void {
    let restart: bool = true;
    while (restart){
        fn to_upper(c: char) char { return c - (c >= 'a' and c <= 'z') * ('a' - 'A'); }

        print("\x1b[?25l\x1b[2J\x1b[H");

        let current_tetromino: []int = tetromino_init();
        let next_tetromino:    []int = tetromino_init();

        let next_tetromino_table: str = tetris_init_next_tetromino_table(next_tetromino);

        let tetris_field: []int = [];
        for (0..TETRIS_WIDTH * TETRIS_HEIGHT) |_|
            push_back(tetris_field, TETROMINO_SHAPE_IDX_NONE);

        let tetris_tick: int = 0;
        let is_running: bool = true;
        while (is_running) : (tetris_tick = tetris_tick + 1){
            let keypress: char = poll_keypress();
            if (keypress){
                let keypress_cpy: char = keypress;

                keypress = to_upper(keypress);

                let new_tetromino: []int = [];
                push_back(new_tetromino, current_tetromino[TETROMINO_SHAPE_IDX_IDX]);
                push_back(new_tetromino, current_tetromino[TETROMINO_ROTATION_IDX_IDX]);
                push_back(new_tetromino, current_tetromino[TETROMINO_X_POS_IDX]);
                push_back(new_tetromino, current_tetromino[TETROMINO_Y_POS_IDX]);

                if (keypress == 'S')
                    new_tetromino[TETROMINO_Y_POS_IDX] = new_tetromino[TETROMINO_Y_POS_IDX] + 1;
                else if (keypress == 'A')
                    new_tetromino[TETROMINO_X_POS_IDX] = new_tetromino[TETROMINO_X_POS_IDX] - 1;
                else if (keypress == 'D')
                    new_tetromino[TETROMINO_X_POS_IDX] = new_tetromino[TETROMINO_X_POS_IDX] + 1;
                else if (keypress_cpy == 'r')
                    tetromino_rotate_right(new_tetromino);
                else if (keypress_cpy == 'R')
                    tetromino_rotate_left(new_tetromino);
                else if (keypress == ' '){
                    while (true){
                        new_tetromino[TETROMINO_Y_POS_IDX] = new_tetromino[TETROMINO_Y_POS_IDX] + 1;
                        if (not tetris_tetromino_fits(tetris_field, new_tetromino))
                            break;
                    }
                    new_tetromino[TETROMINO_Y_POS_IDX] = new_tetromino[TETROMINO_Y_POS_IDX] - 1;
                    tetris_tick = TETRIS_MOVE_TICK - 1;
                }
                else
                    is_running = (keypress != '\x1b');

                if (tetris_tetromino_fits(tetris_field, new_tetromino))
                    current_tetromino = new_tetromino;
            }

            let reached_end: bool = false;
            if ((tetris_tick + 1) % TETRIS_MOVE_TICK == 0){
                current_tetromino[TETROMINO_Y_POS_IDX] = current_tetromino[TETROMINO_Y_POS_IDX] + 1;
                reached_end = not tetris_tetromino_fits(tetris_field, current_tetromino);
                current_tetromino[TETROMINO_Y_POS_IDX] = current_tetromino[TETROMINO_Y_POS_IDX] - reached_end;
            }

            tetris_setup_field_as(tetris_field, current_tetromino, current_tetromino[TETROMINO_SHAPE_IDX_IDX]);

            if (reached_end){
                while (true){
                    let y_start: int = 0;
                    while (y_start < TETRIS_HEIGHT) : (y_start = y_start + 1)
                        if (tetris_row_is_full(tetris_field, y_start))
                            break;

                    if (y_start >= TETRIS_HEIGHT)
                        break;

                    let y_end: int = y_start + 1;
                    while (y_end < TETRIS_HEIGHT and tetris_row_is_full(tetris_field, y_end))
                        y_end = y_end + 1;

                    y_start = y_start * TETRIS_WIDTH;
                    y_end = y_end * TETRIS_WIDTH;

                    let diff: int = y_end - y_start;

                    while (y_start > 0){
                        y_start = y_start - 1;
                        y_end = y_end - 1;
                        tetris_field[y_end] = tetris_field[y_start];
                    }
                    for (0..diff) |x|
                        tetris_field[x] = TETROMINO_SHAPE_IDX_NONE;
                }
            }

            let table: str = "";
            for (0..TETRIS_HEIGHT) |y|{
                table = table + '#';
                for (0..TETRIS_WIDTH) |x|
                    table = table + TETROMINO_SHAPE_SYMBOLS[tetris_field[y * TETRIS_WIDTH + x]];
                table = table + "\x1b[0m#\n";
            }
            for (0..TETRIS_WIDTH + 2) |_|
                table = table + '#';

            print("next:\n" + next_tetromino_table + "\x1b[0m\n" + table + "\x1b[H");

            if (reached_end){
                current_tetromino = next_tetromino;
                next_tetromino = tetromino_init();
                next_tetromino_table = tetris_init_next_tetromino_table(next_tetromino);
                is_running = tetris_tetromino_fits(tetris_field, current_tetromino);
            }
            else
                tetris_setup_field_as(tetris_field, current_tetromino, TETROMINO_SHAPE_IDX_NONE);

            nsleep(25000000);
        }

        print("\x1b[?25h\x1b[0m\x1b[2JDo you wish to restart? (y/n):");

        while (true){
            let keypress: char = to_upper(poll_keypress());
            if (keypress == 'Y' or keypress == 'N'){
                restart = (keypress == 'Y');
                break;
            }
        }
    }
}

main();
